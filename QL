--- query for latest valid account based on cpc

SELECT 
    A.PRIM_ACCNT_NBR    AS ACCOUNT_NO,
    S.ACCNT_STATUS_DESC AS STATUS,
    A.INSRT_TS          AS STATUS_DATE,
    P.CLIENT_PRDCT_CD   AS CPC
FROM ACCNT_HDR A
JOIN PRTNR_PRD P
    ON P.PRTNR_CD_ID = A.PRTNR_CD_ID
JOIN ACCNT_STATUS_CD S
    ON S.ACCNT_STATUS_CD_ID = A.ACCNT_STATUS_CD_ID
WHERE A.CLOSE_TS IS NULL
  AND P.CLIENT_PRDCT_CD IN ('BRD','BBB')
  AND A.INSRT_TS = (
        SELECT MAX(A2.INSRT_TS)
        FROM ACCNT_HDR A2
        JOIN PRTNR_PRD P2
            ON P2.PRTNR_CD_ID = A2.PRTNR_CD_ID
        WHERE A2.CLOSE_TS IS NULL
          AND P2.CLIENT_PRDCT_CD IN ('BRD','BBB')
  );
