<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8" />
<meta name="viewport" content="width=device-width, initial-scale=1.0"/>
<title>Adhy Studio</title>

<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>

<link href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@400;500;700&family=IBM+Plex+Sans:wght@400;500;600&display=swap" rel="stylesheet">

<script src="https://cdn.socket.io/4.5.4/socket.io.min.js"></script>
<script src="https://unpkg.com/lucide@latest"></script>

<style>

:root{
 --bg:#0f1116;
 --panel:#171a22;
 --panel2:#1c2130;
 --line:#2f374f;
 --text:#edf2ff;
 --soft:#90a0bf;
 --accent:#7c9cff;
 --accent2:#7ef0c9;
 --danger:#ff7d8a;
 --warning:#ffd36b;
 --radius:18px;
 --shadow:0 20px 60px rgba(0,0,0,.35);
}

*{
 box-sizing:border-box;
}

body{
 margin:0;
 background:linear-gradient(180deg,#0b0d12,#11151d);
 color:var(--text);
 font-family:'IBM Plex Sans',sans-serif;
 overflow:hidden;
}

.app{
 display:grid;
 grid-template-columns:260px 1fr 360px;
 height:100vh;
}

.sidebar,
.main,
.inspector{
 background:rgba(15,18,25,.92);
 border-right:1px solid rgba(255,255,255,.05);
}

.sidebar{
 padding:20px;
 overflow:auto;
}

.brand{
 display:flex;
 align-items:center;
 gap:12px;
 margin-bottom:28px;
}

.logo{
 width:42px;
 height:42px;
 border-radius:14px;
 background:linear-gradient(135deg,var(--accent),var(--accent2));
}

.brand h1{
 margin:0;
 font-size:1rem;
 font-family:'Space Grotesk';
}

.brand p{
 margin:2px 0 0;
 color:var(--soft);
 font-size:.8rem;
}

.accordion{
 margin-bottom:18px;
}

.acc-header{
 display:flex;
 justify-content:space-between;
 align-items:center;
 cursor:pointer;
 padding:12px 14px;
 border-radius:14px;
 background:rgba(255,255,255,.03);
}

.acc-body{
 padding-top:10px;
 display:block;
}

.nav-btn{
 width:100%;
 border:none;
 background:transparent;
 color:var(--text);
 display:flex;
 align-items:center;
 gap:12px;
 padding:12px;
 border-radius:12px;
 cursor:pointer;
 margin-bottom:6px;
 font-size:.95rem;
}

.nav-btn:hover{
 background:rgba(255,255,255,.05);
}

.nav-btn.active{
 background:rgba(124,156,255,.12);
 border:1px solid rgba(124,156,255,.2);
}

.main{
 display:flex;
 flex-direction:column;
 overflow:hidden;
}

.topbar{
 padding:18px 22px;
 border-bottom:1px solid rgba(255,255,255,.05);
 display:flex;
 justify-content:space-between;
 align-items:center;
}

.toolbar{
 display:flex;
 gap:10px;
 align-items:center;
}

.btn{
 border:none;
 padding:11px 16px;
 border-radius:14px;
 color:white;
 cursor:pointer;
 font-weight:600;
 background:rgba(255,255,255,.06);
}

.btn:hover{
 transform:translateY(-2px);
}

.btn.record{
 background:linear-gradient(135deg,var(--danger),#ff96a1);
}

.btn.run{
 background:linear-gradient(135deg,var(--accent2),#a7ffe0);
 color:#08110f;
}

.workspace{
 flex:1;
 display:grid;
 grid-template-columns:1fr 1fr;
 gap:18px;
 padding:18px;
 overflow:hidden;
}

.panel{
 background:rgba(255,255,255,.03);
 border:1px solid rgba(255,255,255,.06);
 border-radius:22px;
 overflow:hidden;
 display:flex;
 flex-direction:column;
}

.panel-head{
 padding:16px 18px;
 border-bottom:1px solid rgba(255,255,255,.06);
 display:flex;
 justify-content:space-between;
 align-items:center;
}

.panel-body{
 flex:1;
 overflow:auto;
}

.steps{
 padding:12px;
 display:flex;
 flex-direction:column;
 gap:10px;
}

.step{
 display:grid;
 grid-template-columns:42px 1fr auto;
 gap:12px;
 padding:14px;
 border-radius:16px;
 background:rgba(255,255,255,.03);
 cursor:pointer;
 border:1px solid transparent;
}

.step:hover{
 border-color:rgba(124,156,255,.25);
 background:rgba(124,156,255,.08);
}

.step.selected{
 border-color:var(--accent);
}

.step-number{
 width:42px;
 height:42px;
 border-radius:12px;
 background:rgba(255,255,255,.05);
 display:flex;
 align-items:center;
 justify-content:center;
 font-weight:700;
}

.step h4{
 margin:0;
}

.step p{
 margin:4px 0 0;
 color:var(--soft);
 font-size:.85rem;
}

.tag{
 padding:6px 10px;
 border-radius:999px;
 background:rgba(255,255,255,.05);
 font-size:.72rem;
}

.browser{
 height:100%;
 display:flex;
 flex-direction:column;
}

.browser-top{
 padding:14px;
 border-bottom:1px solid rgba(255,255,255,.05);
 display:flex;
 gap:10px;
 align-items:center;
}

.url{
 flex:1;
 padding:10px 14px;
 border-radius:999px;
 border:none;
 background:rgba(255,255,255,.05);
 color:white;
}

.preview{
 flex:1;
 position:relative;
 background:#0a0d14;
}

.preview img{
 width:100%;
 height:100%;
 object-fit:cover;
}

.empty{
 position:absolute;
 top:50%;
 left:50%;
 transform:translate(-50%,-50%);
 text-align:center;
 color:var(--soft);
}

.inspector{
 padding:18px;
 overflow:auto;
}

.status{
 display:flex;
 justify-content:space-between;
 align-items:center;
 padding:16px;
 border-radius:18px;
 background:rgba(255,255,255,.04);
 margin-bottom:18px;
}

.pill{
 padding:8px 14px;
 border-radius:999px;
 background:var(--accent2);
 color:#08110f;
 font-weight:700;
}

.form-block{
 background:rgba(255,255,255,.03);
 border:1px solid rgba(255,255,255,.06);
 border-radius:18px;
 padding:16px;
 margin-bottom:18px;
}

.form-block h3{
 margin-top:0;
}

.input,
.select{
 width:100%;
 padding:12px;
 margin-top:8px;
 margin-bottom:14px;
 border:none;
 border-radius:12px;
 background:rgba(255,255,255,.05);
 color:white;
}

.timeline{
 display:flex;
 flex-direction:column;
 gap:12px;
}

.event{
 padding:12px;
 border-radius:12px;
 background:rgba(255,255,255,.04);
 font-size:.85rem;
 color:var(--soft);
}

.logs{
 max-height:220px;
 overflow:auto;
}

.log{
 padding:10px;
 border-radius:10px;
 margin-bottom:8px;
 background:rgba(255,255,255,.04);
 font-size:.82rem;
}

.pass{
 border-left:4px solid var(--accent2);
}

.fail{
 border-left:4px solid var(--danger);
}

@media(max-width:1200px){
 .app{
  grid-template-columns:220px 1fr;
 }

 .inspector{
  display:none;
 }
}

@media(max-width:900px){
 .app{
  grid-template-columns:1fr;
 }

 .sidebar{
  display:none;
 }

 .workspace{
  grid-template-columns:1fr;
 }
}

</style>
</head>

<body>

<div class="app">

<!-- SIDEBAR -->

<aside class="sidebar">

<div class="brand">
<div class="logo"></div>
<div>
<h1>Adhy Studio</h1>
<p>AI Automation IDE</p>
</div>
</div>

<div class="accordion">

<div class="acc-header">
<span>Workspace</span>
<i data-lucide="chevron-down"></i>
</div>

<div class="acc-body">

<button class="nav-btn active">
<i data-lucide="radio"></i>
Recorder
</button>

<button class="nav-btn">
<i data-lucide="layout-dashboard"></i>
Dashboard
</button>

<button class="nav-btn">
<i data-lucide="network"></i>
API Logs
</button>

<button class="nav-btn">
<i data-lucide="file-code"></i>
Export
</button>

</div>
</div>

<div class="accordion">

<div class="acc-header">
<span>Configuration</span>
<i data-lucide="chevron-down"></i>
</div>

<div class="acc-body">

<select class="select" id="deviceSelect">
<option>Desktop</option>
<option>iPhone 13</option>
<option>Pixel 5</option>
</select>

<label style="display:flex;gap:10px;align-items:center;margin-top:10px;">
<input type="checkbox" id="sfMode"/>
Salesforce Mode
</label>

</div>
</div>

</aside>

<!-- MAIN -->

<main class="main">

<div class="topbar">

<div>
<h2 style="margin:0;font-family:'Space Grotesk'">Visual Recorder</h2>
<p style="margin:4px 0 0;color:var(--soft)">Record, replay and export automation flows.</p>
</div>

<div class="toolbar">

<button class="btn record" id="recordBtn">
🎙 Start Recording
</button>

<button class="btn run" id="runBtn">
▶ Run Test
</button>

<select class="select" id="exportType" style="width:180px;margin:0;">
<option>Playwright JS</option>
<option>Selenium Java</option>
<option>Cucumber Java</option>
<option>Playwright TS</option>
</select>

<button class="btn" id="exportBtn">
📤 Export
</button>

</div>

</div>

<div class="workspace">

<!-- STEPS -->

<section class="panel">

<div class="panel-head">
<h3>Recorded Steps</h3>
<span id="stepCount">0 actions</span>
</div>

<div class="panel-body">

<div class="steps" id="stepsContainer">

<div class="empty">
<h3>No steps yet</h3>
<p>Start recording to capture actions.</p>
</div>

</div>

</div>

</section>

<!-- BROWSER -->

<section class="panel">

<div class="panel-head">
<h3>Live Browser Preview</h3>
<span id="browserStatus">Disconnected</span>
</div>

<div class="browser">

<div class="browser-top">

<input
class="url"
id="urlInput"
value="https://example.com"
/>

<button class="btn" id="goBtn">
Go
</button>

</div>

<div class="preview">

<img id="previewImg" style="display:none"/>

<div class="empty" id="previewEmpty">
<div style="font-size:3rem">🌐</div>
<div>Browser preview will appear here</div>
</div>

</div>

</div>

</section>

</div>

</main>

<!-- INSPECTOR -->

<aside class="inspector">

<div class="status">

<div>
<strong>Recorder Status</strong>
<div style="color:var(--soft);margin-top:4px" id="statusText">
Disconnected
</div>
</div>

<div class="pill" id="statusPill">
IDLE
</div>

</div>

<div class="form-block">

<h3>Step Editor</h3>

<label>Action</label>

<select class="select" id="editAction">
<option>click</option>
<option>type</option>
<option>navigate</option>
<option>assertText</option>
<option>assertVisible</option>
</select>

<label>Locator Strategy</label>

<select class="select" id="locatorType">
<option>css</option>
<option>xpath</option>
<option>aria</option>
<option>id</option>
</select>

<label>Selector</label>

<input class="input" id="editSelector"/>

<label>Value</label>

<input class="input" id="editValue"/>

<div style="display:flex;gap:10px;margin-top:12px">

<button class="btn" style="flex:1">
💾 Save
</button>

<button class="btn" style="flex:1">
🗑 Delete
</button>

</div>

</div>

<div class="form-block">

<h3>Execution Timeline</h3>

<div class="timeline" id="timeline">

<div class="event">
Ready for execution
</div>

</div>

</div>

<div class="form-block">

<h3>API Logs</h3>

<div class="logs" id="apiLogs">

<div class="log">
GET /api/status 200
</div>

</div>

</div>

</aside>

</div>

<script>

lucide.createIcons();

const API = "http://localhost:3000";

const Store = {
 steps: [],
 selectedStep: null,
 apiLogs: [],
 recording: false
};

let socket;

const previewImg = document.getElementById('previewImg');

async function connectBackend(){

 try{

  await fetch(`${API}/api/status`);

  socket = io(API);

  document.getElementById('statusText').innerText = "Connected";
  document.getElementById('browserStatus').innerText = "Connected";

  socket.on('steps:update', data=>{
    Store.steps = data.steps || [];
    renderSteps();
  });

  socket.on('api:log', log=>{
    addApiLog(log);
  });

  socket.on('timeline:new', e=>{
    addTimeline(e.type);
  });

 }catch(e){

  document.getElementById('statusText').innerText = "Connection failed";

 }

}

async function toggleRecording(){

 if(!socket){
   await connectBackend();
 }

 if(!Store.recording){

   await fetch(`${API}/api/init`,{
     method:'POST',
     headers:{'Content-Type':'application/json'},
     body:JSON.stringify({
       url:document.getElementById('urlInput').value,
       device:document.getElementById('deviceSelect').value
     })
   });

   await fetch(`${API}/api/record/start`,{
     method:'POST'
   });

   Store.recording = true;

   updateRecordingUI(true);

   startPreview();

 }else{

   await fetch(`${API}/api/record/stop`,{
     method:'POST'
   });

   Store.recording = false;

   updateRecordingUI(false);

 }

}

function updateRecordingUI(recording){

 const btn = document.getElementById('recordBtn');

 if(recording){

   btn.innerHTML = "⏹ Stop Recording";
   document.getElementById('statusPill').innerText = "REC";
   document.getElementById('statusPill').style.background = "var(--danger)";

 }else{

   btn.innerHTML = "🎙 Start Recording";
   document.getElementById('statusPill').innerText = "IDLE";
   document.getElementById('statusPill').style.background = "var(--accent2)";

 }

}

async function runTest(){

 addTimeline("Execution started");

 await fetch(`${API}/api/run`,{
   method:'POST'
 });

}

function renderSteps(){

 const container = document.getElementById('stepsContainer');

 document.getElementById('stepCount').innerText =
   `${Store.steps.length} actions`;

 if(Store.steps.length === 0){

   container.innerHTML = `
   <div class="empty">
      <h3>No steps yet</h3>
   </div>
   `;

   return;
 }

 let html = "";

 Store.steps.forEach((s,i)=>{

   html += `
   <div class="step" onclick="selectStep(${i})">

      <div class="step-number">
         ${String(i+1).padStart(2,'0')}
      </div>

      <div>
        <h4>${s.action}</h4>
        <p>${s.selector || ''}</p>
      </div>

      <div class="tag">
        ${s.action}
      </div>

   </div>
   `;

 });

 container.innerHTML = html;

}

function selectStep(i){

 Store.selectedStep = i;

 const step = Store.steps[i];

 document.getElementById('editAction').value =
   step.action || '';

 document.getElementById('editSelector').value =
   step.selector || '';

 document.getElementById('editValue').value =
   step.value || '';

}

function addTimeline(text){

 const el = document.createElement('div');

 el.className = "event";

 el.innerHTML = `
 ${new Date().toLocaleTimeString()}<br>
 ${text}
 `;

 document.getElementById('timeline').prepend(el);

}

function addApiLog(log){

 const el = document.createElement('div');

 el.className = "log";

 el.innerHTML = `
 ${log.method} ${log.url}<br>
 Status: ${log.status}
 `;

 document.getElementById('apiLogs').prepend(el);

}

async function startPreview(){

 previewImg.style.display = 'block';

 document.getElementById('previewEmpty').style.display='none';

 setInterval(()=>{

   previewImg.src =
     `${API}/api/preview?t=${Date.now()}`;

 },1000);

}

document.getElementById('recordBtn')
.addEventListener('click',toggleRecording);

document.getElementById('runBtn')
.addEventListener('click',runTest);

document.getElementById('goBtn')
.addEventListener('click',async()=>{

 const url = document.getElementById('urlInput').value;

 await fetch(`${API}/api/navigate`,{
   method:'POST',
   headers:{'Content-Type':'application/json'},
   body:JSON.stringify({url})
 });

});

document.getElementById('exportBtn')
.addEventListener('click',async()=>{

 const language =
   document.getElementById('exportType').value;

 const res = await fetch(`${API}/api/generate`,{
   method:'POST',
   headers:{'Content-Type':'application/json'},
   body:JSON.stringify({language})
 });

 const data = await res.json();

 const blob = new Blob([data.code],{
   type:'text/plain'
 });

 const a = document.createElement('a');

 a.href = URL.createObjectURL(blob);

 a.download = 'adhy-export.txt';

 a.click();

});

</script>

</body>
</html>
